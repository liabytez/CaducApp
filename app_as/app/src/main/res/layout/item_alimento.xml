<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Barra lateral de color según la urgencia -->
        <View
            android:id="@+id/viewIndicadorColor"
            android:layout_width="8dp"
            android:layout_height="match_parent"
            android:background="@color/urgencia_verde" />

        <!-- Contenedor principal de la información -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Nombre del alimento -->
            <TextView
                android:id="@+id/tvNombreAlimento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Leche Entera" />

            <!-- Categoría y cantidad -->
            <TextView
                android:id="@+id/tvCategoriaCantidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#555555"
                android:textSize="14sp"
                tools:text="Lácteos • 2 cartones" />

            <!-- Fecha de caducidad -->
            <TextView
                android:id="@+id/tvFechaCaducidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#757575"
                android:textSize="13sp"
                tools:text="Caduca: 25/11/2026" />

        </LinearLayout>

        <!-- Columna derecha: días restantes y botón -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical|end"
            android:orientation="vertical"
            android:paddingEnd="12dp"
            android:paddingStart="4dp"
            android:paddingVertical="8dp">

            <!-- Etiqueta con los días restantes -->
            <TextView
                android:id="@+id/tvDiasRestantes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/fondo_verde_suave"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/primary_dark"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="En 6 días" />

            <!-- Botón para marcar como consumido -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConsumido"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingHorizontal="8dp"
                android:text="@string/marcar_consumido"
                android:textSize="12sp"
                app:icon="@android:drawable/checkbox_on_background"
                app:iconSize="16dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
