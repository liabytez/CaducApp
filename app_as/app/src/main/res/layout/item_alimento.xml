<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="7dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Indicador lateral de urgencia -->
        <View
            android:id="@+id/viewIndicadorColor"
            android:layout_width="7dp"
            android:layout_height="match_parent"
            android:background="@color/urgencia_verde" />

        <!-- Información del alimento -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="16dp"
            android:paddingEnd="6dp"
            android:paddingBottom="16dp">

            <!-- Nombre -->
            <TextView
                android:id="@+id/tvNombreAlimento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Leche Entera" />

            <!-- Categoría y cantidad -->
            <TextView
                android:id="@+id/tvCategoriaCantidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/leaf"
                android:textSize="13sp"
                tools:text="Lácteos • 2 cartones" />

            <!-- Fecha -->
            <TextView
                android:id="@+id/tvFechaCaducidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Caduca: 25/11/2026" />

        </LinearLayout>

        <!-- Estado y acción -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="12dp"
            android:paddingVertical="10dp">

            <!-- Días restantes -->
            <TextView
                android:id="@+id/tvDiasRestantes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_etiqueta_caducidad"
                android:gravity="center"
                android:minWidth="76dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="7dp"
                android:textColor="@color/urgencia_verde"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="En 6 días" />

            <!-- Marcar como consumido -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConsumido"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingHorizontal="6dp"
                android:text="@string/marcar_consumido"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:maxLines="1"
                app:icon="@android:drawable/checkbox_on_background"
                app:iconSize="16dp"
                app:iconTint="@color/leaf"
                app:iconPadding="3dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
